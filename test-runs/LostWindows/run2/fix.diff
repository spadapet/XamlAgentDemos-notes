+    private static void ShowToolWindow(Window window)
+    {
+        window.Show();
+        WindowLayout.EnsureVisible(window);
+        window.Activate();
+    }
+
     private T Create<T>(string layoutKey)
         where T : Window, new()
     {
         var window = new T { Owner = this };
         WindowLayout.Restore(window, layoutKey);
+        window.Closed += (_, _) =>
+        {
+            if (ReferenceEquals(this.settingsWindow, window)) this.settingsWindow = null;
+            if (ReferenceEquals(this.notificationsWindow, window)) this.notificationsWindow = null;
+            if (ReferenceEquals(this.inspectorWindow, window)) this.inspectorWindow = null;
+        };
         return window;
     }
 }
