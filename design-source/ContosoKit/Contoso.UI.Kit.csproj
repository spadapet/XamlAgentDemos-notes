<Project Sdk="Microsoft.NET.Sdk">
  <!-- Stand-in for a closed-source third-party control library. Only the compiled DLL is copied into
       XamlAgentDemos\lib, so the demos can't read this source. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>Contoso.UI.Kit</AssemblyName>
    <RootNamespace>Contoso.UI.Kit</RootNamespace>
    <Nullable>enable</Nullable>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>3.2.1</Version>
  </PropertyGroup>
</Project>
