<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Contoso.UI.Kit">

  <Style TargetType="local:PeopleStrip">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:PeopleStrip">
          <ItemsPresenter />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <WrapPanel />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
    <Setter Property="ItemTemplate">
      <Setter.Value>
        <DataTemplate>
          <StackPanel Width="96" Margin="6">
            <Grid Width="56" Height="56" HorizontalAlignment="Center">
              <Ellipse Fill="{Binding AvatarColor, FallbackValue=#FFD0D0D0}" />
              <TextBlock Text="{Binding Initials}" Foreground="White" FontSize="20" FontWeight="SemiBold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding DisplayName}" Margin="0,6,0,0" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
            <TextBlock Text="{Binding Role}" Foreground="#FF6B6B6B" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
        </DataTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="local:ActionCard">
    <Setter Property="Margin" Value="8" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="local:ActionCard">
          <Border Background="White" BorderBrush="#FFE1E1E6" BorderThickness="1" CornerRadius="8" Padding="16">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <TextBlock Text="{TemplateBinding Header}" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
              <ContentPresenter Grid.Row="1" />
              <!-- Hover sheen over the header and body. -->
              <Border x:Name="PART_Sheen" Grid.RowSpan="2" Background="#01FFFFFF" CornerRadius="4" />
              <ContentPresenter Grid.Row="2" Content="{TemplateBinding Actions}" Margin="0,12,0,0" HorizontalAlignment="Right" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger SourceName="PART_Sheen" Property="IsMouseOver" Value="True">
              <Setter TargetName="PART_Sheen" Property="Background" Value="#0A3B5BDB" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>
